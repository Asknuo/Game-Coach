# ── Go ──
collector/bin/
*.exe
*.test

# ── Python ──
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
dist/
/build/
*.egg
# 注意：上面的 /build/ 已锚定到根目录（Python 打包产物），
# 下面的例外确保 agent/skills/build/（出装教练 skill，业务代码）不被误伤。
!agent/skills/build/

# ── 虚拟环境 ──
.venv/
venv/

# ── 敏感配置 ──
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json
secrets.*
config.local.*

# ── 本地问题记录（不上传远程） ──
ISSUES.md

# ── 向量数据库 ──
chroma_db/
*.chroma/
chroma_data/

# ── 运行时数据 ──
*.log
*.bak
agent/memory/data/
agent/chroma_data/

# ── IDE ──
.idea/
.vscode/
*.swp
*.swo
*~
.trae/

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini

# ── Node（如果有前端） ──
node_modules/
.npm/
.next/
dist-frontend/
